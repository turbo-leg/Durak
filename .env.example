# ── Server ───────────────────────────────────────────────────────────────────

# MongoDB connection string (required in production)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/durak

# JWT secret for email/password auth tokens — MUST be set in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Redis connection URL (optional — enables multi-instance horizontal scaling)
REDIS_URL=redis://localhost:6379

# Port the Colyseus server listens on (default: 2567)
PORT=2567

# Process admission limits for the initial ~100-player launch. Reconnects retain seats.
MAX_ACTIVE_ROOMS=120
MAX_CONNECTED_CLIENTS=150
MAX_ACTIVE_BOTS=120

# Optional GET /metrics bearer token. Unset = endpoint disabled (404).
# Operational counts/memory/event-loop metrics are also logged every 30 seconds.
# METRICS_TOKEN=generate-a-long-random-token

# Required persistent result outbox for production. Mount this directory on durable
# storage: Fly/Compose use /data/results. Do not share it between running processes.
# RESULT_OUTBOX_DIR=/data/results

# ── Discord OAuth (server-side token exchange) ────────────────────────────────

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ── Client (Vite) ─────────────────────────────────────────────────────────────
# Create packages/client/.env.local and set:

# VITE_DISCORD_CLIENT_ID=your_discord_client_id   (required — app throws at startup if missing)
